  - NodeID: 1
    lines:
    - name: Lana
      picture: {fileID: -7697192603752915565, guid: 9c614b37372db52479f18eac58893475, type: 3}
      message: I'm good. Waht about others?
    - name: OldLana
      picture: {fileID: 8212712898034683147, guid: fea91fe3b8103a447847e9d63af8d296, type: 3}
      message: Last days were too difficult for everyone of us.
    nextNodeID: 3
    choices: []
  - NodeID: 2
    lines:
    - name: Lana
      picture: {fileID: -7697192603752915565, guid: 9c614b37372db52479f18eac58893475, type: 3}
      message: Feel bad for myself. Can't find out why.
    - name: OldLana
      picture: {fileID: 8212712898034683147, guid: fea91fe3b8103a447847e9d63af8d296, type: 3}
      message: That's sad to hear. I'll pray for you at the evening.
    nextNodeID: 3
    choices: []
  - NodeID: 3
    lines:
    - name: OldLana
      picture: {fileID: 8212712898034683147, guid: fea91fe3b8103a447847e9d63af8d296, type: 3}
      message: Could you please, bring me some flowers
    nextNodeID: 3
    choices:
    - choiceText: Yes.
      nextNodeID: 4
      keyChoice: Ready to help
    - choiceText: No.
      nextNodeID: 5
      keyChoice: 
  - NodeID: 4
    lines:
    - name: OldLana
      picture: {fileID: 8212712898034683147, guid: fea91fe3b8103a447847e9d63af8d296, type: 3}
      message: Thank you very much.
    nextNodeID: 6
    choices: []
  - NodeID: 5
    lines:
    - name: OldLana
      picture: {fileID: 8212712898034683147, guid: fea91fe3b8103a447847e9d63af8d296, type: 3}
      message: Sorry, for bothering you.
    nextNodeID: 6
    choices: []
