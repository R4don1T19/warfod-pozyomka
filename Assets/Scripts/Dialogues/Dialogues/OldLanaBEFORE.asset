    lines:
    - name: OldLana
      picture: {fileID: 8212712898034683147, guid: fea91fe3b8103a447847e9d63af8d296, type: 3}
      message: Haven't seen you these little days.
    - name: OldLana
      picture: {fileID: 8212712898034683147, guid: fea91fe3b8103a447847e9d63af8d296, type: 3}
      message: How are you?
    nextNodeID: 
